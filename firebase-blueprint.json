{
  "entities": {
    "AcademicEvent": {
      "title": "AcademicEvent",
      "description": "Agenda, hari libur, atau jadwal ujian dalam kalender pendidikan sekolah.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Judul kegiatan, ujian, atau hari libur" },
        "category": { "type": "string", "description": "Kategori event: libur, ujian, kegiatan, rapat, atau penting" },
        "startDate": { "type": "string", "description": "Tanggal mulai format YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "Tanggal selesai format YYYY-MM-DD" },
        "description": { "type": "string", "description": "Deskripsi atau catatan tambahan" },
        "targetClass": { "type": "string", "description": "Kelas target atau 'Semua Kelas'" },
        "isHoliday": { "type": "boolean", "description": "Apakah hari tersebut libur sekolah" },
        "color": { "type": "string", "description": "Kode warna aksen kategori" },
        "createdBy": { "type": "string", "description": "Nama pembuat event" },
        "createdAt": { "type": "string", "description": "Waktu pembuatan ISO timestamp" }
      },
      "required": ["title", "category", "startDate", "endDate"]
    },
    "ClassSchedule": {
      "title": "ClassSchedule",
      "description": "Jadwal pelajaran harian atau jadwal ujian kelas.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "Tingkat kelas" },
        "type": { "type": "string", "description": "pelajaran atau ujian" },
        "hari": { "type": "string", "description": "Hari (Senin-Sabtu) atau tanggal YYYY-MM-DD untuk ujian" },
        "jam": { "type": "string", "description": "Rentang waktu pelaksanaan" },
        "mataPelajaran": { "type": "string", "description": "Nama mata pelajaran" },
        "pengajar": { "type": "string", "description": "Nama guru pengampu" },
        "ruangan": { "type": "string", "description": "Ruang kelas atau lokasi" },
        "keterangan": { "type": "string", "description": "Catatan tambahan materi" }
      },
      "required": ["classId", "type", "hari", "jam", "mataPelajaran"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Tugas atau pekerjaan rumah online yang diberikan guru untuk siswa/wali murid.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Judul tugas atau materi" },
        "subject": { "type": "string", "description": "Mata pelajaran terkait" },
        "classId": { "type": "string", "description": "Target kelas siswa" },
        "description": { "type": "string", "description": "Instruksi dan petunjuk pengerjaan tugas" },
        "dueDate": { "type": "string", "description": "Batas tanggal pengumpulan format YYYY-MM-DD" },
        "dueTime": { "type": "string", "description": "Batas jam pengumpulan HH:mm" },
        "maxScore": { "type": "number", "description": "Skor atau nilai maksimal tugas" },
        "attachmentUrl": { "type": "string", "description": "Lampiran berkas atau materi panduan tugas" },
        "attachmentName": { "type": "string", "description": "Nama file lampiran" },
        "teacherId": { "type": "string", "description": "ID atau username guru" },
        "teacherName": { "type": "string", "description": "Nama guru pembuat tugas" },
        "status": { "type": "string", "description": "Status tugas: active atau closed" },
        "mode": { "type": "string", "description": "Mode tugas: 'online_quiz' (dikerjakan & dinilai otomatis) atau 'file_upload' (unggah foto/berkas)" },
        "questions": { "type": "array", "description": "Daftar soal pilihan ganda & esai berserta kunci jawaban untuk koreksi otomatis" },
        "createdAt": { "type": "string", "description": "Waktu pembuatan ISO timestamp" }
      },
      "required": ["title", "subject", "classId", "dueDate", "teacherName"]
    },
    "AssignmentSubmission": {
      "title": "AssignmentSubmission",
      "description": "Pengumpulan tugas online oleh siswa/wali murid beserta status penilaian dan feedback guru.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string", "description": "ID tugas yang dikerjakan" },
        "studentId": { "type": "string", "description": "ID siswa yang mengumpulkan" },
        "studentName": { "type": "string", "description": "Nama siswa" },
        "studentAbsen": { "type": "string", "description": "Nomor absen siswa" },
        "classId": { "type": "string", "description": "Tingkat kelas siswa" },
        "submissionText": { "type": "string", "description": "Jawaban teks atau keterangan pengerjaan tugas" },
        "attachmentUrl": { "type": "string", "description": "Foto lembar jawaban atau file tugas yang dikumpulkan" },
        "attachmentName": { "type": "string", "description": "Nama file lampiran tugas" },
        "studentAnswers": { "type": "array", "description": "Jawaban online siswa per butir soal (pilihan ganda / esai)" },
        "autoGraded": { "type": "boolean", "description": "Apakah telah dikoreksi & dinilai otomatis oleh sistem" },
        "submittedAt": { "type": "string", "description": "Waktu pengumpulan ISO timestamp" },
        "submittedBy": { "type": "string", "description": "Nama pengirim (wali murid atau siswa)" },
        "isLate": { "type": "boolean", "description": "Apakah pengumpulan melebihi batas waktu" },
        "status": { "type": "string", "description": "submitted, graded, atau revision_needed" },
        "score": { "type": "number", "description": "Nilai yang diberikan guru" },
        "feedback": { "type": "string", "description": "Umpan balik atau evaluasi catatan dari guru" },
        "feedbackAt": { "type": "string", "description": "Waktu feedback diberikan" },
        "feedbackBy": { "type": "string", "description": "Nama guru yang menilai" }
      },
      "required": ["assignmentId", "studentId", "studentName", "classId", "submittedAt"]
    }
  },
  "firestore": {
    "/kalender_akademik/{eventId}": {
      "schema": { "$ref": "#/entities/AcademicEvent" },
      "description": "Koleksi acara kalender akademik, hari libur nasional/sekolah, dan agenda ujian."
    },
    "/jadwal_kelas/{scheduleId}": {
      "schema": { "$ref": "#/entities/ClassSchedule" },
      "description": "Koleksi jadwal pelajaran dan jadwal ujian per kelas."
    },
    "/tugas/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Koleksi tugas dan PR online yang dibuat oleh guru."
    },
    "/pengumpulan_tugas/{submissionId}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Koleksi lembar pengumpulan tugas siswa beserta penilaian dan feedback guru."
    }
  }
}
